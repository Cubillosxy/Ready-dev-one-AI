# Audio capture
RDOAI_AUDIO_DEVICE_INDEX=1
RDOAI_DICTATION_DEVICE_INDEX=2
RDOAI_MODE=meeting

# STT provider selection: openai | local
RDOAI_STT_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=replace_me
RDOAI_OPENAI_STT_MODEL=gpt-4o-mini-transcribe

RDOAI_OPENAI_STT_LANGUAGE=en

# Vosk
# Streaming STT (local)
RDOAI_STREAMING_STT_PROVIDER=vosk
RDOAI_VOSK_MODEL_PATH=models/vosk-model-small-en-us-0.15
RDOAI_VOSK_MODEL_ES=models/vosk-model-small-es-0.42


RDOAI_LLM_PROVIDER=lmstudio
RDOAI_LLM_BASE_URL=http://localhost:1234/v1

RDOAI_LLM_MODEL=model-identifier
RDOAI_LLM_TEMPERATURE=0.3

# When to trigger the assistant
RDOAI_ASSIST_TRIGGER=on_pause   # on_pause | manual